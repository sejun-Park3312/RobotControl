const int dirPins[8] = {32, 30, 28, 26, 33, 31, 29, 27}; // 방향 제어
const int brkPins[3] = {42, 44, 46};                  // 브레이크 제어
const int pwmPin[3] = {13, 12, 11}; // +x, -x, center
const unsigned long Ts = 10;  // 대기 시간 (밀리초 단위)

int pwmValue[3] = {0, 0, 0}; // +x, -x, center

void setup() {
  Serial.begin(115200);
  for (int i = 0; i < 8; i++) pinMode(dirPins[i], OUTPUT);
  for (int i = 0; i < 3; i++) pinMode(brkPins[i], OUTPUT);
  for (int i = 0; i < 3; i++) pinMode(pwmPin[i], OUTPUT);

  digitalWrite(dirPins[0], HIGH); // 1사분면
  digitalWrite(dirPins[1], LOW);  // 2사분면
  digitalWrite(dirPins[2], HIGH); // 3사분면
  digitalWrite(dirPins[3], LOW);  // 4사분면
  digitalWrite(dirPins[4], LOW); // +x
  digitalWrite(dirPins[5], LOW); // -x
  digitalWrite(dirPins[6], HIGH);  // +-y
  digitalWrite(dirPins[7], HIGH); // center

  for (int i = 0; i < 3; i++) digitalWrite(brkPins[i], HIGH);
}

void loop() {
  bool success = false;
  int attempts = 0;

  while (attempts < 3 && !success) {
    if (Serial.available() > 0) {
      String input = Serial.readStringUntil('\n');
      input.trim();

      if (input.length() > 0) {
        // 파이썬에서 "val1,val2,val3" 형식으로 보낸다고 가정
        int values[3] = {0, 0, 0};
        int idx = 0;
        int lastPos = 0;
        for (int i = 0; i <= input.length(); i++) {
          if (input[i] == ',' || i == input.length()) {
            String part = input.substring(lastPos, i);
            values[idx++] = part.toInt();
            lastPos = i + 1;
            if (idx >= 3) break;
          }
        }

        // 모든 값이 999이면 정지
        if (values[0] == 999 && values[1] == 999 && values[2] == 999) {
          for (int i = 0; i < 3; i++) analogWrite(pwmPin[i], 0);
          for (int i = 0; i < 3; i++) digitalWrite(brkPins[i], HIGH);
          Serial.println("Stopped by Python");
          while(1);  // 무한정 정지
        } else {
          for (int i = 0; i < 3; i++) {
            pwmValue[i] = values[i];
            digitalWrite(brkPins[i], LOW); // 브레이크 해제
          }
          success = true;
        }
      }
    } else {
      attempts++;
      delay(1);
    }
  }

  // PWM 출력
  for (int i = 0; i < 3; i++) {
    analogWrite(pwmPin[i], pwmValue[i]);
  }

  delay(Ts);  // Ts 밀리초 대기
}
